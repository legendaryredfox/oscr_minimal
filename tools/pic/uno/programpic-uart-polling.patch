@@ -18,6 +18,23 @@
 #define __PROG_TYPES_COMPAT__
 #include <avr/pgmspace.h>       // For PROGMEM
 
+// UART por polling, sem ISR: o HardwareSerial (interrupcoes do UART) falha neste Uno.
+struct PolledSerial : public Print {
+    void begin(unsigned long baud) {
+        UCSR0A = (1 << U2X0);
+        UBRR0 = (uint16_t)((F_CPU / 4 / baud - 1) / 2);
+        UCSR0B = (1 << TXEN0) | (1 << RXEN0);     // sem RXCIE0 nem UDRIE0
+        UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
+    }
+    int available() { return (UCSR0A & (1 << RXC0)) ? 1 : 0; }
+    int read() { return (UCSR0A & (1 << RXC0)) ? UDR0 : -1; }
+    size_t write(uint8_t c) { while (!(UCSR0A & (1 << UDRE0))) {} UDR0 = c; return 1; }
+    size_t write(const uint8_t *b, size_t n) { for (size_t i = 0; i < n; ++i) write(b[i]); return n; }
+    void flush() {}
+};
+static PolledSerial PSerial;
+#define Serial PSerial
+
